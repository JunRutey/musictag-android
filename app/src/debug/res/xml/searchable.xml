<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug variant of res/xml/searchable.xml.

  The debug build ships as com.xjcheng.musictageditor.debug and its providers derive
  their authorities from that applicationId (see AndroidManifest.xml), so the search
  dialog has to be pointed at the debug authority too. Nothing here reaches a release
  APK: the release resources come from src/main and keep the contract values.
-->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:hint="@string/search_hint"
    android:label="@string/app_name"
    android:searchSuggestAuthority="com.xjcheng.musictageditor.debug.SearchSugg"
    android:searchSuggestIntentAction="android.intent.action.VIEW"
    android:searchSuggestIntentData="content://com.xjcheng.musictageditor.debug/datatable"
    android:searchSuggestSelection=" ?" />
